# ============================================
# КОНФИГУРАЦИЯ QUADPLANE (4 МОТОРА, БЕЗ РУЛЕЙ)
# Дифференциальная тяга для горизонтального полета
# ============================================

# --- Основные параметры QuadPlane ---
Q_ENABLE,1                  # Включить режим QuadPlane
Q_FRAME_CLASS,1             # 1 = стандартный QuadPlane (горизонтальный)
Q_FRAME_TYPE,1              # 1 = X-рама (моторы по диагоналям)

# --- Параметры Tailsitter (Игнорируются при Q_FRAME_CLASS=1, но оставлены для справки) ---
Q_TAILSIT_MOTMX,15          # Маска моторов (15 = все 4 мотора)
Q_TAILSIT_ANGLE,45          # Угол тангажа для перехода
Q_TAILSIT_VTOL_FW,1         # Разрешить переход VTOL -> FW
Q_TAILSIT_TRANS_THR,0.75    # Порог газа для перехода
Q_TAILSIT_INPUT,0           # Тип управления (1 = самолетный)
Q_TAILSIT_RLL_MX,0          # Макс. угол крена
Q_TAILSIT_VHGAIN,0.5        # Усиление удержания высоты
Q_TAILSIT_VFGAIN,0.0        # Усиление движения вперед

# --- Назначение сервоприводов и моторов ---
# Каналы 1-4 отключены, так как нет рулей (элероны, элеватор, газ, руддер)
SERVO1_FUNCTION,0           # Отключен (был элерон)
SERVO2_FUNCTION,0           # Отключен (был элеватор)
SERVO3_FUNCTION,0           # Отключен (был газ самолета)
SERVO4_FUNCTION,0           # Отключен (был руддер)

# Каналы 5-8 назначены на моторы для дифференциальной тяги
SERVO5_FUNCTION,33          # Motor 1 (передний правый)
SERVO6_FUNCTION,34          # Motor 2 (задний левый)
SERVO7_FUNCTION,35          # Motor 3 (передний левый)
SERVO8_FUNCTION,36          # Motor 4 (задний правый)

# --- Параметры моторов (VTOL) ---
Q_M_PWM_MIN,1000            # Минимальный PWM (мкс)
Q_M_PWM_MAX,2000            # Максимальный PWM (мкс)
Q_M_SPIN_MIN,0.15           # Мин. обороты при арминге (15%)
Q_M_SPIN_MAX,0.95           # Макс. обороты (95%)
Q_M_THST_HOVER,0.35         # Ожидаемый газ для висения (35%)
Q_M_THST_EXPO,0.65          # Экспоненциальная кривая газа

# --- Навигация и фильтры (AHRS/EKF) ---
AHRS_EKF_TYPE,3             # Использовать EKF3
EK3_ENABLE,1                # Включить EKF3
EK2_ENABLE,0                # Отключить старый EKF2

# --- Проверки и сенсоры (ОТКЛЮЧЕНЫ ДЛЯ СИМУЛЯЦИИ) ---
ARMING_CHECK,0              # Отключить все проверки перед армингом
COMPASS_ENABLE,0            # Отключить компас
GPS_TYPE,0                  # Отключить GPS
BARO_ENABLE,0               # Отключить барометр
BATT_MONITOR,0              # Отключить мониторинг батареи

# --- Режимы полета и аппаратура (RC) ---
FLTMODE1,10                 # Позиция 1: QSTABILIZE
FLTMODE2,11                 # Позиция 2: QHOVER
FLTMODE3,3                  # Позиция 3: FBWA (самолетный)
FLTMODE4,4                  # Позиция 4: AUTO
FLTMODE5,6                  # Позиция 5: RTL
FLTMODE6,7                  # Позиция 6: MANUAL
INITIAL_MODE,10             # Режим при включении: QSTABILIZE
FLTMODE_CH,8                # Переключатель режимов на 8 канале

# Распределение каналов RC
RCMAP_ROLL,1               # Крен на 1 канале
RCMAP_PITCH,2               # Тангаж на 2 канале
RCMAP_THROTTLE,3            # Газ на 3 канале
RCMAP_YAW,4                 # Рысканье на 4 канале

# --- PID-регуляторы (Настройка отклика дрона) ---
# Контроллеры позиции и скорости (XY)
Q_P_POSXY_P,0.5             # P-коэф. контроллера позиции
Q_P_VELXY_P,0.7             # P-коэф. контроллера скорости
Q_P_VELXY_I,0.35            # I-коэф. скорости (убирает дрейф)
Q_P_VELXY_D,0.17            # D-коэф. скорости (сглаживает рывки)

# Контроллеры угловой скорости (Rate)
Q_A_RAT_RLL_P,0.08          # P-коэф. скорости крена
Q_A_RAT_RLL_I,0.08          # I-коэф. скорости крена
Q_A_RAT_RLL_D,0.003         # D-коэф. скорости крена (гасит вибрации)
Q_A_RAT_PIT_P,0.08          # P-коэф. скорости тангажа
Q_A_RAT_PIT_I,0.08          # I-коэф. скорости тангажа
Q_A_RAT_PIT_D,0.003         # D-коэф. скорости тангажа
Q_A_RAT_YAW_P,0.18          # P-коэф. скорости рысканья
Q_A_RAT_YAW_I,0.018         # I-коэф. скорости рысканья
Q_A_RAT_YAW_D,0.0           # D-коэф. скорости рысканья

# Контроллеры углов (Angle)
Q_A_ANG_RLL_P,4.0           # P-коэф. угла крена
Q_A_ANG_PIT_P,4.0           # P-коэф. угла тангажа
Q_A_ANG_YAW_P,3.0           # P-коэф. угла рысканья